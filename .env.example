# Firebase web app config. The project is named "ng-native-psw-mng" in the console, but its
# project ID is ng-password-manager-30e2f (Project settings > General). Use the ID, not the name.
# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Expo inlines EXPO_PUBLIC_* variables into the bundle; these are identifiers, not secrets.
# Access is protected by firestore.rules and Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ng-password-manager-30e2f.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ng-password-manager-30e2f
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ng-password-manager-30e2f.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
