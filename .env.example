# Firebase web app config for project ng-native-psw-mng.
# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Expo inlines EXPO_PUBLIC_* variables into the bundle; these are identifiers, not secrets.
# Access is protected by firestore.rules and Firebase Auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ng-native-psw-mng.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ng-native-psw-mng
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ng-native-psw-mng.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
